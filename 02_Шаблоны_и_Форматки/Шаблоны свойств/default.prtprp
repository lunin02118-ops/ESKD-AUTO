<?xml version="1.0" encoding="UTF-8"?>
<CPSheet AppVersion="33">
  <GroupBox Label="Идентификация по ЕСКД" PropName="Groupbox_ESKD" DefaultState="Expanded">
    <Control Label="Обозначение" PropName="Обозначение" ApplyTo="Global" Type="TextBox" Mode="Text" DefaultValue="" />
    <Control Label="Наименование" PropName="Наименование" ApplyTo="Global" Type="TextBox" Mode="Text" DefaultValue="" />
  </GroupBox>
  <GroupBox Label="Материал детали (ГОСТ)" PropName="Groupbox_Material" DefaultState="Expanded">
    <Control Label="Материал SolidWorks" PropName="Материал" ApplyTo="Global" Type="TextBox" Mode="SWProperty" DefaultValue="SW-Material" ReadOnly="True" />
  </GroupBox>
  <GroupBox Label="Основная надпись" PropName="Groupbox_Dev" DefaultState="Expanded">
    <Control Label="Разработал" PropName="Конструктор" ApplyTo="Global" Type="TextBox" Mode="Text" DefaultValue="" />
    <Control Label="Проверил" PropName="Проверил" ApplyTo="Config" Type="TextBox" Mode="Text" DefaultValue="" />
    <Control Label="Организация" PropName="Контора" ApplyTo="Config" Type="TextBox" Mode="Text" DefaultValue="" />
    <Control Label="Литера" PropName="Литера_ФБ" ApplyTo="Config" Type="ComboBox" UserDefineable="True">
      <Item>-</Item>
      <Item>Э</Item>
      <Item>Т</Item>
      <Item>О</Item>
      <Item>О1</Item>
      <Item>А</Item>
      <Item>Б</Item>
    </Control>
    <Control Label="Масса (SW)" PropName="Масса" ApplyTo="Global" Type="TextBox" Mode="SWProperty" DefaultValue="SW-Mass" ReadOnly="True" />
  </GroupBox>
</CPSheet>