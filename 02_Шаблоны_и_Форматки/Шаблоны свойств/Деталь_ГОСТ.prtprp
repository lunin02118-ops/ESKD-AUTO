<?xml version="1.0" encoding="UTF-8"?>
<CPSheet AppVersion="33">
  <GroupBox Label="Идентификация по ЕСКД" PropName="Groupbox_ESKD" DefaultState="Expanded">
    <Control Label="Обозначение" PropName="Обозначение" ApplyTo="Global" Type="TextBox" Mode="Text" DefaultValue="" />
    <Control Label="Наименование" PropName="Наименование" ApplyTo="Global" Type="TextBox" Mode="Text" DefaultValue="" />
  </GroupBox>
  <GroupBox Label="Материал детали (ГОСТ)" PropName="Groupbox_Material" DefaultState="Expanded">
    <Control Label="Материал SolidWorks" PropName="Материал" ApplyTo="Global" Type="TextBox" Mode="SWProperty" DefaultValue="SW-Material" ReadOnly="True" />
  </GroupBox>
  <GroupBox Label="Сведения об исполнителе" PropName="Groupbox_Dev" DefaultState="Expanded">
    <Control Label="Разработал" PropName="Разработал" ApplyTo="Global" Type="List" UserDefineable="True">
      <Item Label="Лунин В.И." PropValue="Лунин В.И." />
    </Control>
    <Control Label="Проверил" PropName="Проверил" ApplyTo="Global" Type="TextBox" Mode="Text" DefaultValue="" />
    <Control Label="Организация" PropName="Организация" ApplyTo="Global" Type="TextBox" Mode="Text" DefaultValue="Home Made" />
    <Control Label="Литера" PropName="Литера" ApplyTo="Global" Type="List" UserDefineable="True">
      <Item Label="-" PropValue="" />
      <Item Label="Э" PropValue="Э" />
      <Item Label="Т" PropValue="Т" />
      <Item Label="О" PropValue="О" />
      <Item Label="О1" PropValue="О1" />
      <Item Label="А" PropValue="А" />
      <Item Label="Б" PropValue="Б" />
    </Control>
    <Control Label="Масса (SW)" PropName="Масса" ApplyTo="Global" Type="TextBox" Mode="SWProperty" DefaultValue="SW-Mass" ReadOnly="True" />
  </GroupBox>
</CPSheet>