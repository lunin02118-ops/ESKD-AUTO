<?xml version="1.0" encoding="utf-8"?>

<configuration>
  <configSections>
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="CADBooster.Drew.Drawing.Properties.Settings"
               type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    </sectionGroup>
  </configSections>

  <applicationSettings>
    <CADBooster.Drew.Drawing.Properties.Settings>
      <setting name="CompanyName" serializeAs="String">
        <value>CAD Booster</value>
      </setting>
      <setting name="ProductName" serializeAs="String">
        <value>Drew</value>
      </setting>
      <setting name="ProductDescription" serializeAs="String">
        <value>Create, edit and review drawings twice as fast</value>
      </setting>
      <setting name="BlueprintsFileName" serializeAs="String">
        <value>Drew-Blueprints</value>
      </setting>
      <setting name="LogFileFolder" serializeAs="String">
        <value>logs</value>
      </setting>
      <setting name="LogFileName" serializeAs="String">
        <value>log</value>
      </setting>
      <setting name="StatisticsFileName" serializeAs="String">
        <value>Statistics</value>
      </setting>
      <setting name="PersonalSettingsFileName" serializeAs="String">
        <value>PersonalSettings</value>
      </setting>
    </CADBooster.Drew.Drawing.Properties.Settings>
  </applicationSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>