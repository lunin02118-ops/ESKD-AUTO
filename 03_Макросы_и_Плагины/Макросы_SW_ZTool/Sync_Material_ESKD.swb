' SolidWorks VBA Macro: Sync_Material_ESKD
' Zero-Click / 1-Click ESKD Material and Rolled Stock Synchronizer
Option Explicit

Sub main()
    Dim swApp As SldWorks.SldWorks
    Set swApp = Application.SldWorks
    
    Dim model As SldWorks.ModelDoc2
    Set model = swApp.ActiveDoc
    
    If model Is Nothing Then
        MsgBox "Откройте деталь или чертеж для синхронизации материалов ЕСКД.", vbInformation, "ЕСКД Материалы"
        Exit Sub
    End If
    
    Dim part As SldWorks.PartDoc
    If model.GetType = 1 Then ' swDocPART
        Set part = model
    ElseIf model.GetType = 3 Then ' swDocDRAWING
        Dim drw As SldWorks.DrawingDoc
        Set drw = model
        Dim v As SldWorks.View
        Set v = drw.GetFirstView
        If Not v Is Nothing Then Set v = v.GetNextView
        If Not v Is Nothing Then
            Dim refDoc As SldWorks.ModelDoc2
            Set refDoc = v.ReferencedDocument
            If Not refDoc Is Nothing Then
                If refDoc.GetType = 1 Then Set part = refDoc
            End If
        End If
    End If
    
    If part Is Nothing Then
        MsgBox "Активный документ должен быть деталью или чертежом детали.", vbExclamation, "ЕСКД Материалы"
        Exit Sub
    End If
    
    Dim cfgName As String
    Dim cfg As SldWorks.Configuration
    Set cfg = part.GetActiveConfiguration
    If Not cfg Is Nothing Then cfgName = cfg.Name
    
    Dim dbName As String
    Dim matName As String
    matName = part.GetMaterialPropertyName2(cfgName, dbName)
    If matName = "" Then matName = part.GetMaterialPropertyName2("", dbName)
    
    If matName = "" Then
        MsgBox "Детали не назначен физический материал в SolidWorks!", vbExclamation, "ЕСКД Материалы"
        Exit Sub
    End If
    
    ' Detect Sheet Metal
    Dim isSheetMetal As Boolean: isSheetMetal = False
    Dim thicknessMm As Double: thicknessMm = 0
    Dim feat As SldWorks.Feature
    Set feat = part.FirstFeature
    Do While Not feat Is Nothing
        Dim tname As String
        tname = feat.GetTypeName2
        If tname = "SheetMetal" Or tname = "SMBaseFlange" Then
            isSheetMetal = True
            On Error Resume Next
            Dim p As SldWorks.Dimension
            Set p = part.Parameter("Thickness@" & feat.Name)
            If p Is Nothing Then Set p = part.Parameter("Толщина@" & feat.Name)
            If p Is Nothing Then Set p = part.Parameter("""D1@" & feat.Name & """")
            If Not p Is Nothing Then
                If p.SystemValue > 0.00001 Then thicknessMm = Round(p.SystemValue * 1000#, 2)
            End If
            On Error GoTo 0
            Exit Do
        End If
        Set feat = feat.GetNextFeature
    Loop
    
    Dim prokat As String: prokat = ""
    Dim matFB As String: matFB = ""
    Dim matSP As String: matSP = ""
    
    If isSheetMetal And thicknessMm > 0.001 And InStr(matName, " / ") = 0 Then
        Dim tStr As String
        tStr = Replace(CStr(thicknessMm), ".", ",")
        prokat = "Лист Б-ПН-О-" & tStr & " ГОСТ 19903-2015"
        matFB = "<STACK size=1>" & prokat & "<OVER>" & matName & "</STACK>"
        matSP = prokat & " / " & matName
    ElseIf InStr(matName, " / ") > 0 Then
        Dim parts() As String
        parts = Split(matName, " / ")
        prokat = Trim(parts(0))
        Dim steel As String
        steel = Trim(parts(1))
        matFB = "<STACK size=1>" & prokat & "<OVER>" & steel & "</STACK>"
        matSP = matName
    Else
        prokat = ""
        matFB = matName
        matSP = matName
    End If
    
    Dim cpmDoc As SldWorks.CustomPropertyManager
    Set cpmDoc = part.Extension.CustomPropertyManager("")
    Dim cpmCfg As SldWorks.CustomPropertyManager
    If cfgName <> "" Then Set cpmCfg = part.Extension.CustomPropertyManager(cfgName)
    
    SetProperty cpmDoc, cpmCfg, "Материал_ФБ", matFB
    SetProperty cpmDoc, cpmCfg, "Материал", matSP
    If prokat <> "" Then
        SetProperty cpmDoc, cpmCfg, "Сортамент", prokat
    Else
        DeleteProperty cpmDoc, cpmCfg, "Сортамент"
    End If
    
    part.ForceRebuild3 False
    If model.GetType = 3 Then model.ForceRebuild3 False
End Sub

Sub SetProperty(cpmDoc As SldWorks.CustomPropertyManager, cpmCfg As SldWorks.CustomPropertyManager, propName As String, propVal As String)
    cpmDoc.Add3 propName, 30, propVal, 1
    cpmDoc.Set2 propName, propVal
    If Not cpmCfg Is Nothing Then
        cpmCfg.Add3 propName, 30, propVal, 1
        cpmCfg.Set2 propName, propVal
    End If
End Sub

Sub DeleteProperty(cpmDoc As SldWorks.CustomPropertyManager, cpmCfg As SldWorks.CustomPropertyManager, propName As String)
    On Error Resume Next
    cpmDoc.Delete2 propName
    If Not cpmCfg Is Nothing Then cpmCfg.Delete2 propName
    On Error GoTo 0
End Sub
