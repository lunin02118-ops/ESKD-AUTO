' ==============================================================================
' Макрос: Синхронизация ЕСКД в 1 клик (Материал, Масса, Штамп)
' Совместимость: SolidWorks 2018 - 2026 / SWPlus
' ==============================================================================
Option Explicit

Sub main()
    Dim swApp As Object
    Dim addin As Object
    Dim exePath As String
    Dim macroPath As String
    Dim myAppID As Variant
    
    Set swApp = Application.SldWorks
    macroPath = swApp.GetCurrentMacroPathName
    exePath = Left$(macroPath, InStrRev(macroPath, "\")) & "ESKD_Sync.exe"
    
    If Dir(exePath) <> "" Then
        myAppID = Shell(Chr(34) & exePath & Chr(34), vbHide)
    Else
        On Error Resume Next
        Set addin = swApp.GetAddInObject("{B64E6875-B101-4D5C-B245-FF8D50772E25}")
        If Not addin Is Nothing Then
            addin.SyncCurrentDoc
        Else
            MsgBox "Файл ESKD_Sync.exe не найден по пути: " & vbCrLf & exePath, vbCritical, "Ошибка синхронизации"
        End If
    End If
End Sub