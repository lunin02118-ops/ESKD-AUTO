@echo off
chcp 65001 > nul
rem Обновление инструментария ЕСКД в общей папке из официального репозитория GitHub.
rem Запускает администратор со своей машины. Конструкторам это не нужно: они после обновления
rem запускают «Настройка_Рабочего_Места_SolidWorks.exe» из общей папки, как обычно.
rem
rem Общую папку укажите в переменной ниже — один раз, после чего файл запускается двойным щелчком.
set "ОБЩАЯ_ПАПКА=\\Synology_TR\Конструкторский отдел\_Библиотека проектирования\_инструменты_конструктора"

powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%~dp0Обновить_из_GitHub.ps1" -Target "%ОБЩАЯ_ПАПКА%" %*
echo.
pause
